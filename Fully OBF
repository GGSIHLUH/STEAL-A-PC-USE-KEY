local function saveKeyData()
    if writefile then
        local expireTime = os.time() + 86400
        pcall(function()
            writefile("SenarHubKey.json", tostring(expireTime))
        end)
    end
end

local function checkSavedKey()
    if readfile and pcall(function() readfile("SenarHubKey.json") end) then
        local success, data = pcall(function()
            return readfile("SenarHubKey.json")
        end)
        if success and data then
            local expireTime = tonumber(data)
            if expireTime and os.time() < expireTime then
                return true
            end
        end
    end
    return false
end

local function loadHub()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/GGSIHLUH/STEAL-A-PC-FREE/refs/heads/main/Use%20Key"))()
    end)
end

